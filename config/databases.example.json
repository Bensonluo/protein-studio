    "colabfold-local": {
      "name": "ColabFold local CPU MMseqs2, no templates",
      "engine": "colabfold",
      "example": true,
      "release": "uniref30_2302+colabfold_envdb_202108-REPLACE_WITH_INSTALLED_MANIFEST",
      "root": "/srv/protein-databases/colabfold",
      "prepareVersion": "REPLACE_WITH_INSTALLED_ENGINE_AND_RUNNER_VERSION",
      "searchVersion": "REPLACE_WITH_INSTALLED_SEARCH_TOOL_VERSION",
      "assets": [
        {
          "name": "uniref30_db",
          "kind": "sequence",
          "type": "prefix",
          "path": "uniref30_2302_db",
          "required": true,
          "requiredSuffixes": [
            "",
            ".dbtype",
            ".index",
            "_seq",
            "_seq.dbtype",
            "_seq.index",
            "_aln",
            "_aln.dbtype",
            "_aln.index"
          ]
        },
        {
          "name": "environment_db",
          "kind": "sequence",
          "type": "prefix",
          "path": "colabfold_envdb_202108_db",
          "required": true,
          "requiredSuffixes": [
            "",
            ".dbtype",
            ".index",
            "_seq",
            "_seq.dbtype",
            "_seq.index",
            "_aln",
            "_aln.dbtype",
            "_aln.index"
          ]
        },
        {
          "name": "uniref30_taxonomy",
          "kind": "sequence",
          "type": "file",
          "path": "uniref30_2302_db_taxonomy",
          "required": true
        },
        {
          "name": "uniref30_mapping",
          "kind": "sequence",
          "type": "file",
          "path": "uniref30_2302_db_mapping",
          "required": true
        }
      ],
      "searchParameters": {
        "threads": 8,
        "use_env": 1,
        "use_env_pairing": 0,
        "mmseqs": "/opt/colabfold/bin/mmseqs"
      },
      "templateParameters": {
        "use_templates": false
      },
      "sourceURLs": [
        "https://github.com/sokrypton/ColabFold/blob/main/README.md",
        "https://github.com/sokrypton/ColabFold/blob/main/setup_databases.sh"
      ],
      "notes": "Verify explicit MMseqs family members against the installed setup_databases.sh release. CPU batch MSA normally uses MMSEQS_NO_INDEX=1; a .idx precomputed index is not universally required. Enable local templates only after adding template_db and local_pdb_path assets and recording their snapshots."
    },
    "af3-mmseqs-cpu": {
      "name": "AF3 MMseqs2 CPU unpaired + native UniProt pairing/templates",
      "engine": "alphafold3",
      "validationProfile": "af3-mmseqs-v1",
      "example": true,
      "release": "REPLACE_WITH_IMMUTABLE_COLABFOLD_AND_UNIPROT_PDB_SNAPSHOTS",
      "root": "/srv/protein-databases/colabfold-expandable",
      "prepareVersion": "mmseqs-af3-v1+REPLACE_WITH_RUNNER_COMMIT",
      "searchVersion": "REPLACE_WITH_INSTALLED_MMSEQS_HMMER_VERSIONS",
      "searchBackend": {
        "id": "mmseqs2-colabfold",
        "device": "cpu",
        "version": "REPLACE_WITH_INSTALLED_MMSEQS_VERSION",
        "colabfoldVersion": "1.6.3",
        "adapterVersion": "mmseqs-af3-v1",
        "databaseFormat": "colabfold-expandable",
        "gpuServer": false,
        "pairingStrategy": "native-uniprot",
        "templateStrategy": "native-af3"
      },
      "prepareCommand": [
        "/opt/colabfold/bin/python",
        "/srv/foldspace/scripts/mmseqs_af3_runner.py",
        "--phase",
        "search",
        "--input",
        "{input_json}",
        "--profile-json",
        "{profile_json}",
        "--output-dir",
        "{output_dir}"
      ],
      "finalizeCommand": [
        "/opt/colabfold/bin/python",
        "/srv/foldspace/scripts/mmseqs_af3_runner.py",
        "--phase",
        "finalize",
        "--input",
        "{input_json}",
        "--profile-json",
        "{profile_json}",
        "--output-dir",
        "{output_dir}"
      ],
      "executables": {
        "colabfold_search_binary": "/opt/colabfold/bin/colabfold_search",
        "mmseqs_binary": "/opt/colabfold/bin/mmseqs",
        "af3_python": "/opt/af3/venv/bin/python",
        "jackhmmer_binary_path": "/usr/bin/jackhmmer",
        "hmmsearch_binary_path": "/usr/bin/hmmsearch",
        "hmmbuild_binary_path": "/usr/bin/hmmbuild"
      },
      "assets": [
        {
          "name": "uniref30_db",
          "kind": "sequence",
          "type": "prefix",
          "path": "uniref30_2302_db",
          "required": true,
          "requiredSuffixes": [
            "",
            ".dbtype",
            ".index",
            "_seq",
            "_seq.dbtype",
            "_seq.index",
            "_seq_h",
            "_seq_h.dbtype",
            "_seq_h.index",
            "_aln",
            "_aln.dbtype",
            "_aln.index"
          ]
        },
        {
          "name": "environment_db",
          "kind": "sequence",
          "type": "prefix",
          "path": "colabfold_envdb_202108_db",
          "required": true,
          "requiredSuffixes": [
            "",
            ".dbtype",
            ".index",
            "_seq",
            "_seq.dbtype",
            "_seq.index",
            "_seq_h",
            "_seq_h.dbtype",
            "_seq_h.index",
            "_aln",
            "_aln.dbtype",
            "_aln.index"
          ]
        },
        {
          "name": "uniprot_cluster_annot_database_path",
          "kind": "sequence",
          "type": "file",
          "path": "native/uniprot_all_2021_04.fa",
          "required": true
        },
        {
          "name": "seqres_database_path",
          "kind": "template",
          "type": "file",
          "path": "native/pdb_seqres_2022_09_28.fasta",
          "required": true
        },
        {
          "name": "pdb_database_path",
          "kind": "template",
          "type": "directory",
          "path": "native/mmcif_files",
          "required": true
        }
      ],
      "searchParameters": {
        "threads": 8,
        "use_env": 1,
        "db_load_mode": 2,
        "s": 8,
        "jackhmmer_n_cpu": 8
      },
      "templateParameters": {
        "max_template_date": "2021-09-30"
      },
      "sourceURLs": [
        "https://github.com/sokrypton/ColabFold/tree/v1.6.3",
        "https://github.com/soedinglab/MMseqs2/wiki",
        "https://github.com/google-deepmind/alphafold3/blob/v3.0.4/docs/input.md"
      ],
      "notes": "Example only. Native AF3 remains a separate selectable profile. CPU/GPU MMseqs results are different search provenance; compare scientific outcomes before promotion. GPU requires independent SEARCH_GPU_GROUPS_JSON and common host GPU_LOCK_DIR. GPU databaseFormat is an administrator declaration, not a proof of padded/index compatibility. External persistent gpuserver is not managed or accepted. Native CPU finalization runs after releasing the search GPU lease."
    },
