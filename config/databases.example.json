    "af2-reduced-local": {
      "name": "AF2 reduced-database inventory (monomer + multimer assets)",
      "engine": "alphafold2",
      "example": true,
      "release": "AF2-v2.3.2-database-manifest-REPLACE_WITH_SNAPSHOT",
      "root": "/srv/protein-databases/alphafold2",
      "prepareVersion": "REPLACE_WITH_INSTALLED_ENGINE_AND_RUNNER_VERSION",
      "searchVersion": "REPLACE_WITH_INSTALLED_SEARCH_TOOL_VERSION",
      "assets": [
        {
          "name": "uniref90_database_path",
          "kind": "sequence",
          "type": "file",
          "path": "uniref90/uniref90.fasta",
          "required": true
        },
        {
          "name": "mgnify_database_path",
          "kind": "sequence",
          "type": "file",
          "path": "mgnify/mgy_clusters_2022_05.fa",
          "required": true
        },
        {
          "name": "small_bfd_database_path",
          "kind": "sequence",
          "type": "file",
          "path": "small_bfd/bfd-first_non_consensus_sequences.fasta",
          "required": true
        },
        {
          "name": "uniprot_database_path",
          "kind": "sequence",
          "type": "file",
          "path": "uniprot/uniprot.fasta",
          "required": true
        },
        {
          "name": "pdb_seqres_database_path",
          "kind": "template",
          "type": "file",
          "path": "pdb_seqres/pdb_seqres.txt",
          "required": true
        },
        {
          "name": "template_mmcif_dir",
          "kind": "template",
          "type": "directory",
          "path": "pdb_mmcif/mmcif_files",
          "required": true
        },
        {
          "name": "obsolete_pdbs_path",
          "kind": "template",
          "type": "file",
          "path": "pdb_mmcif/obsolete.dat",
          "required": true
        },
        {
          "name": "pdb70_database_path",
          "kind": "template",
          "type": "prefix",
          "path": "pdb70/pdb70",
          "required": true,
          "requiredSuffixes": [
            "_a3m.ffdata",
            "_a3m.ffindex",
            "_hhm.ffdata",
            "_hhm.ffindex",
            "_cs219.ffdata",
            "_cs219.ffindex"
          ]
        }
      ],
      "searchParameters": {},
      "templateParameters": {
        "max_template_date": "2021-09-30"
      },
      "sourceURLs": [
        "https://github.com/google-deepmind/alphafold/blob/v2.3.2/README.md",
        "https://github.com/google-deepmind/alphafold/blob/v2.3.2/run_alphafold.py"
      ],
      "notes": "Registry inventory only; current campaign staged execution supports AF3 and ColabFold. The direct AF2 runner uses administrator CLI flags. For full_dbs add BFD and UniRef30 explicit index members and change the CLI preset."
    },
