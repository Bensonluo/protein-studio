# Keep the actual /etc/foldspace/workers/<worker-id>.env readable only to the service administrator.
# Declare the same worker ID and tokenEnv on the controller; token values are not source files.
FOLDSPACE_CONTROLLER_URL=https://foldspace-controller.example.org
PS_WORKER_TOKEN=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
FOLDSPACE_RUNTIME_VERSION=AF3-v3.0.4-REPLACE_COMMIT
FOLDSPACE_GPU_DEVICES=0
FOLDSPACE_SAMPLES=5
FOLDSPACE_RECYCLES=10
FOLDSPACE_RESIDENT_COMMAND='["/opt/alphafold3/venv/bin/python","/srv/foldspace/scripts/resident_runner.py","--engine","alphafold3","--af3-script","/opt/alphafold3/run_alphafold.py","--model-dir","/srv/protein-models/alphafold3","--model-version","AF3-v3.0.4-REPLACE_COMMIT","--num-samples","5","--num-recycles","10","--allowed-root","/srv/foldspace-workers"]'
