# Place in the nginx http{} include directory after configuring a real DNS name
# and certificate. Controller remains on loopback; management API is NOT public.
# Worker config url example: https://fold-worker.example.org:4443
server {
    listen 4443 ssl;
    server_name fold-worker.example.org;

    ssl_certificate     /etc/ssl/foldspace/fullchain.pem;
    ssl_certificate_key /etc/ssl/foldspace/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    # 1 GiB ingress ceiling. Actual accepted ZIP size is still bounded by the
    # administrator registry maxBundleBytes (e.g. 256 / 512 MiB), and expanded
    # bytes by maxExpandedBytes. Set these together, not independently.
    client_max_body_size 1g;
    client_body_timeout 1800s;
    send_timeout 1800s;

    location ^~ /worker/v1/ {
        # Preserve URI; do not add a trailing slash to proxy_pass.
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:8765;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 1800s;
        proxy_read_timeout 1800s;
        # Do not replay a target upload to another upstream automatically.
        proxy_next_upstream off;
        # The controller authenticates the bearer token and worker identity.
        limit_except GET POST { deny all; }
    }

    # In particular, /api/, /, /sources.json and static UI never reach the
    # unauthenticated browser application through this public listener.
    location / { return 404; }
}
