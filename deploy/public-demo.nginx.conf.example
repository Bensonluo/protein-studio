# Include inside the existing benluo.art HTTPS server block.
# The upstream receives the prefix unchanged; the application owns URL generation.
location = /foldspace {
    return 308 /foldspace/;
}
location ^~ /foldspace/ {
    proxy_pass http://127.0.0.1:8765;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    client_max_body_size 1m;
    # The public application also enforces read-only access in its handler.
    limit_except GET HEAD { deny all; }
}
